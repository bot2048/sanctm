import { S, App, Actions } from "../state.slint";
import { Body, Btn, StateIcon } from "../widgets.slint";

// What happened, what to do: the message on top, the actions at the bottom.
export component ErrorPage inherits Rectangle {
    background: S.bg;
    property <color> tone: App.error-soft ? S.warn : S.bad;
    property <length> actions-h: App.error-retry ? 176px : 100px;
    VerticalLayout {
        y: 0px;
        height: parent.height - root.actions-h;
        padding-left: S.gutter;
        padding-right: S.gutter;
        padding-top: S.top-inset;
        spacing: S.s5;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 96px;
                height: 96px;
                border-radius: 48px;
                background: root.tone.with-alpha(0.14);
                border-width: 2px;
                border-color: root.tone;
                StateIcon {
                    width: 44px;
                    height: 44px;
                    kind: App.error-soft ? 1 : 2;
                }
            }
        }
        Text {
            text: App.error-title;
            color: root.tone;
            font-family: S.sans;
            font-size: S.t-title-lg;
            font-weight: 800;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Body {
            text: App.error-body;
            color: S.muted;
            horizontal-alignment: center;
        }
    }
    VerticalLayout {
        y: parent.height - root.actions-h;
        height: root.actions-h;
        padding-left: S.gutter;
        padding-right: S.gutter;
        padding-top: S.s3;
        padding-bottom: 28px;
        spacing: S.s4;
        // A profile that did not load may be a passing read error: retry before anything
        // offers to start over.
        if App.error-retry: Btn {
            text: "Try again";
            clicked => {
                Actions.retry-load();
            }
        }
        Btn {
            text: App.error-retry ? "Start over" : "OK";
            kind: App.error-retry ? 1 : 0;
            clicked => {
                Actions.go-home();
            }
        }
    }
}
