import { Images } from "@ui/theme.slint";
import { S, App, Actions, Pages, Overlay } from "../state.slint";
import { Body, Btn, Chip, Bubble, LockIcon, VerifiedIcon, Avatar, BackIcon, ReplyIcon, IconBtn, EmojiIcon, EmptyState, MessageField } from "../widgets.slint";

// Conversation header: back, their avatar, name and short npub, then contact details (or
// closing the action bar while a message is selected).
component ThreadHeader inherits Rectangle {
    height: S.header-h;
    background: S.bg;
    Rectangle {
        x: 0px;
        width: 56px;
        height: parent.height;
        Rectangle {
            x: 8px;
            width: 40px;
            height: 40px;
            border-radius: S.r-lg;
            background: back-ta.pressed ? S.panel : transparent;
            BackIcon {
                width: 26px;
                height: 26px;
            }
        }
        back-ta := TouchArea {
            clicked => {
                Actions.back-to-chats();
            }
        }
    }
    Avatar {
        x: 56px;
        size: 40px;
        initial: App.thread-initial;
        tint: App.thread-tint;
        picture: App.thread-avatar;
        has-picture: App.thread-has-avatar;
    }
    VerticalLayout {
        x: 108px;
        width: parent.width - self.x - 72px;
        alignment: center;
        spacing: 1px;
        Text {
            text: App.thread-name;
            color: S.text;
            font-family: App.thread-mono ? S.mono : S.sans;
            font-size: App.thread-mono ? 16px : S.t-heading;
            font-weight: 700;
            overflow: elide;
        }
        if App.thread-subtitle != "": HorizontalLayout {
            spacing: 4px;
            if App.thread-subtitle-verified: VerticalLayout {
                alignment: center;
                VerifiedIcon {
                    width: 12px;
                    height: 12px;
                }
            }
            Text {
                text: App.thread-subtitle;
                color: S.muted;
                font-family: App.thread-subtitle-verified ? S.sans : S.mono;
                font-size: S.t-meta;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
    if App.selected-id == "": IconBtn {
        x: parent.width - 56px;
        icon: S.dark ? Images.image("user-d") : Images.image("user-l");
        icon-size: 20px;
        clicked => {
            Actions.open-contact(App.thread-peer);
        }
    }
    if App.selected-id != "": IconBtn {
        x: parent.width - 56px;
        icon: S.dark ? Images.image("close-d") : Images.image("close-l");
        icon-size: 20px;
        clicked => {
            Actions.select("");
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: S.line;
    }
}

component ReactButton inherits Rectangle {
    in property <string> key;
    in property <bool> mine;
    callback clicked();
    width: 56px;
    height: 56px;
    border-radius: S.r-lg;
    background: ta.pressed ? S.panel-hi : root.mine ? S.accent-soft : S.panel;
    border-width: root.mine ? 2px : 0px;
    border-color: S.accent;
    EmojiIcon {
        key: root.key;
        width: 30px;
        height: 30px;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component ThreadPage inherits Rectangle {
    // Height of the KeyOS on-screen keyboard while it is up (the window is not resized).
    in property <length> keyboard: 0px;
    background: S.bg;
    property <int> bytes: Actions.byte-len(App.compose-text);
    property <bool> can-send: root.bytes > 0 && root.bytes <= 2000 && !Actions.is-blank(App.compose-text);
    // Rust asks for the field's focus (Reply, or the old "compose" entry point).
    property <int> focus-tick: App.focus-tick;
    changed focus-tick => {
        field.take-focus();
    }
    function send() {
        if root.can-send {
            list.follow = true;
            Actions.send(App.compose-text);
        }
    }
    VerticalLayout {
        padding-top: S.top-inset;
        padding-bottom: root.keyboard;
        ThreadHeader { }
        if !App.thread-known: Rectangle {
            background: S.warn.with-alpha(0.10);
            HorizontalLayout {
                padding-left: S.gutter;
                padding-right: S.s3;
                padding-top: S.s2;
                padding-bottom: S.s2;
                spacing: S.s3;
                Text {
                    text: "Not in your contacts. Check their npub before you trust a name.";
                    color: S.warn;
                    font-family: S.sans;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Chip {
                    text: "Add contact";
                    tone: S.warn;
                    clicked => {
                        Actions.open-contact(App.thread-peer);
                    }
                }
            }
        }
        list := Flickable {
            vertical-stretch: 1;
            // Follow the newest message (at the bottom) unless the user scrolled up to read.
            property <bool> follow: true;
            property <length> bottom: min(0px, self.height - self.viewport-height);
            init => {
                self.viewport-y = self.bottom;
            }
            changed bottom => {
                if self.follow {
                    self.viewport-y = self.bottom;
                }
            }
            changed viewport-y => {
                self.follow = self.viewport-y <= self.bottom + 8px;
            }
            // Tapping the conversation (not a message) puts the keyboard away.
            TouchArea {
                clicked => {
                    field.drop-focus();
                }
            }
            VerticalLayout {
                padding-left: S.list-inset;
                padding-right: S.list-inset;
                padding-top: S.list-inset;
                padding-bottom: S.list-inset;
                spacing: 3px;
                alignment: App.messages.length == 0 ? center : end;
                if App.messages.length == 0: VerticalLayout {
                    padding-left: S.s4;
                    padding-right: S.s4;
                    padding-bottom: S.s6;
                    EmptyState {
                        icon: Images.image("lock-p");
                        title: "Say hi";
                        body: "Messages are sealed on this Passport. Only the two of you can read them. Tap a message to react or reply.";
                    }
                }
                // What protects this conversation, once, above its first message.
                if App.messages.length > 0: HorizontalLayout {
                    alignment: center;
                    padding-bottom: S.s2;
                    Rectangle {
                        height: 24px;
                        width: seal.preferred-width + 2 * S.s3;
                        seal := HorizontalLayout {
                            x: S.s3;
                            width: parent.width - 2 * S.s3;
                            spacing: 6px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                LockIcon {
                                    width: 13px;
                                    height: 13px;
                                }
                            }
                            Text {
                                text: "Sealed on this Passport with NIP-17";
                                color: S.faint;
                                font-family: S.sans;
                                font-size: S.t-meta;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                for m in App.messages: Bubble {
                    m: m;
                    selected: App.selected-id == m.id;
                    tapped => {
                        Actions.select(m.id);
                    }
                    media-tapped => {
                        Actions.load-media(m.id);
                    }
                    picture-tapped => {
                        Actions.open-picture(m.id);
                    }
                }
            }
        }
        // Top of the dock (action bar + composer): a floating toast sits above this line.
        Rectangle {
            height: 1px;
            background: S.line;
            init => {
                Overlay.thread-dock-top = self.y;
            }
            changed y => {
                Overlay.thread-dock-top = self.y;
            }
        }
        // Action bar for the selected message: react, reply, keep its picture.
        if App.selected-id != "": VerticalLayout {
            padding-left: S.gutter;
            padding-right: S.gutter;
            padding-top: S.s3;
            padding-bottom: 2px;
            spacing: S.s2;
            HorizontalLayout {
                spacing: S.s2;
                height: 56px;
                for e in [
                    { key: "heart", emoji: "❤️" },
                    { key: "thumbs", emoji: "👍" },
                    { key: "joy", emoji: "😂" },
                    { key: "fire", emoji: "🔥" },
                    { key: "pray", emoji: "🙏" },
                ]: ReactButton {
                    key: e.key;
                    mine: App.selected-emoji == e.key;
                    clicked => {
                        Actions.react(e.emoji);
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 56px;
                    border-radius: S.r-lg;
                    background: reply-ta.pressed ? S.panel-hi : S.panel;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            ReplyIcon {
                                width: 20px;
                                height: 20px;
                            }
                        }
                        Text {
                            text: "Reply";
                            color: S.text;
                            font-family: S.sans;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    reply-ta := TouchArea {
                        clicked => {
                            Actions.start-reply();
                        }
                    }
                }
            }
            if App.selected-failed && App.link-up: Btn {
                text: "Send again now";
                kind: 1;
                button-height: S.btn-h-sm;
                clicked => {
                    Actions.retry-send();
                }
            }
            if App.selected-can-keep: Btn {
                text: "Keep picture in Sanctm";
                kind: 1;
                button-height: S.btn-h-sm;
                clicked => {
                    Actions.keep-picture(App.selected-id);
                }
            }
        }
        // The composer.
        VerticalLayout {
            padding-left: S.s4;
            padding-right: S.s4;
            padding-top: 10px;
            padding-bottom: S.s3;
            spacing: S.s2;
            // Offline, an error, or close to the size limit: one small line.
            if !App.link-up || App.compose-error != "" || root.bytes > 1800: HorizontalLayout {
                padding-left: S.s2;
                padding-right: S.s2;
                spacing: S.s3;
                Text {
                    text: App.compose-error != "" ? App.compose-error : !App.link-up ? "No phone linked: messages wait sealed here and go out when one is." : "";
                    color: App.compose-error != "" ? S.bad : S.faint;
                    font-family: S.sans;
                    font-size: S.t-meta;
                    font-weight: 600;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                if root.bytes > 1800: Text {
                    text: root.bytes + " / 2000";
                    color: root.bytes > 2000 ? S.bad : S.faint;
                    font-family: S.mono;
                    font-size: S.t-meta;
                    font-weight: root.bytes > 2000 ? 700 : 400;
                    horizontal-alignment: right;
                }
            }
            // Replying: the quoted message, which can be dropped.
            if App.replying: Rectangle {
                height: max(52px, rq.preferred-height);
                background: S.panel;
                border-radius: S.r-lg;
                Rectangle {
                    x: 0px;
                    y: 8px;
                    width: 3px;
                    height: parent.height - 16px;
                    border-radius: 1.5px;
                    background: S.accent;
                }
                rq := VerticalLayout {
                    x: 0px;
                    width: parent.width - 52px;
                    padding-left: S.s4;
                    padding-top: S.s2;
                    padding-bottom: S.s2;
                    spacing: 1px;
                    alignment: center;
                    Text {
                        text: "Replying to " + App.reply-author;
                        color: S.accent-text;
                        font-family: S.sans;
                        font-size: S.t-meta;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: App.reply-text;
                        color: S.muted;
                        font-family: S.sans;
                        font-size: 13px;
                        overflow: elide;
                    }
                }
                IconBtn {
                    x: parent.width - 46px;
                    size: 36px;
                    outlined: false;
                    icon: S.dark ? Images.image("close-d") : Images.image("close-l");
                    icon-size: 16px;
                    clicked => {
                        Actions.cancel-reply();
                    }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                field := MessageField {
                    horizontal-stretch: 1;
                    value <=> App.compose-text;
                    placeholder: App.replying ? "Reply…" : "Message…";
                }
                VerticalLayout {
                    alignment: end;
                    Rectangle {
                        width: 52px;
                        height: 52px;
                        border-radius: S.r-lg;
                        background: send-ta.pressed ? S.fill-pressed : root.can-send ? S.fill : S.panel;
                        animate background { duration: 120ms; }
                        Image {
                            width: 24px;
                            height: 24px;
                            source: root.can-send ? Images.image("send-w") : S.dark ? Images.image("send-md") : Images.image("send-ml");
                            image-fit: contain;
                        }
                        send-ta := TouchArea {
                            enabled: root.can-send;
                            clicked => {
                                root.send();
                            }
                        }
                    }
                }
            }
        }
    }
}
