import { Images } from "@ui/theme.slint";
import { S, App, Actions, Pages, ChatRow } from "../state.slint";
import { UserIcon, ChevronIcon, IconBtn, Body, Panel, Badge, Avatar, Btn, EmptyState } from "../widgets.slint";

// One row of the chats list: full width, a divider under it from the text column on.
component ChatItem inherits Rectangle {
    in property <ChatRow> chat;
    in property <bool> last;
    callback open();
    // Width of the time column: "now" up to "Sep 25 2025" (older than this year).
    property <length> side: max(48px, when.preferred-width);
    property <bool> unread: root.chat.unread > 0;
    property <length> text-x: S.gutter + 48px + S.s4;
    height: 76px;
    background: ta.pressed ? S.panel : transparent;
    ta := TouchArea {
        clicked => {
            root.open();
        }
    }
    Avatar {
        x: S.gutter;
        size: 48px;
        initial: root.chat.initial;
        tint: root.chat.tint;
        picture: root.chat.avatar;
        has-picture: root.chat.has-avatar;
    }
    VerticalLayout {
        x: root.text-x;
        width: parent.width - root.text-x - root.side - S.gutter - S.s3;
        alignment: center;
        spacing: 3px;
        HorizontalLayout {
            spacing: S.s2;
            Text {
                text: root.chat.name;
                color: S.text;
                font-family: root.chat.mono ? S.mono : S.sans;
                font-size: root.chat.mono ? 15px : S.t-row;
                font-weight: root.chat.mono ? 400 : (root.unread ? 700 : 600);
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            // Not in your contacts ("New" would read as "unread").
            if !root.chat.known: VerticalLayout {
                alignment: center;
                Badge {
                    text: "Unknown";
                }
            }
        }
        Text {
            text: root.chat.preview;
            color: root.unread ? S.text : S.muted;
            font-family: S.sans;
            font-size: S.t-small;
            overflow: elide;
        }
    }
    VerticalLayout {
        x: parent.width - S.gutter - root.side;
        width: root.side;
        alignment: center;
        spacing: 6px;
        when := Text {
            text: root.chat.when;
            color: root.unread ? S.accent-text : S.faint;
            font-family: S.sans;
            font-size: S.t-meta;
            font-weight: root.unread ? 700 : 400;
            horizontal-alignment: right;
        }
        // Always reserve the count's row, so the time sits at the same height in every row.
        HorizontalLayout {
            alignment: end;
            height: 20px;
            if root.unread: Rectangle {
                width: max(20px, n.preferred-width + 10px);
                height: 20px;
                border-radius: 10px;
                background: S.fill;
                n := Text {
                    text: root.chat.unread > 99 ? "99+" : root.chat.unread;
                    color: S.on-accent;
                    font-family: S.sans;
                    font-size: S.t-meta;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    if !root.last: Rectangle {
        x: root.text-x;
        y: parent.height - 1px;
        width: parent.width - root.text-x;
        height: 1px;
        background: S.line;
    }
}

// The phone link: the state in its colour, what it means, and a way to Me (link, relays).
component LinkLine inherits Rectangle {
    property <color> tone: App.link-up ? (App.link-title == "No relays" ? S.warn : App.synced ? S.ok : S.accent-text) : S.faint;
    height: max(56px, lay.preferred-height);
    background: ta.pressed ? S.panel : transparent;
    ta := TouchArea {
        clicked => {
            Actions.show-me();
        }
    }
    lay := HorizontalLayout {
        padding-left: S.gutter;
        padding-right: S.s4;
        padding-top: S.s3;
        padding-bottom: S.s3;
        spacing: S.s3;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.tone;
                    }
                }
                Text {
                    text: App.link-title;
                    color: root.tone;
                    font-family: S.sans;
                    font-size: S.t-small;
                    font-weight: 600;
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: App.link-detail;
                color: S.muted;
                font-family: S.sans;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            ChevronIcon {
                width: 18px;
                height: 18px;
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: S.line;
    }
}

export component ChatsPage inherits Rectangle {
    background: S.bg;
    property <bool> empty: App.chats.length == 0;
    property <length> empty-actions: 2 * S.btn-h + S.s3 + S.s3 + 28px;
    Flickable {
        y: S.top-inset;
        height: parent.height - S.top-inset - (root.empty ? root.empty-actions : 0px);
        VerticalLayout {
            padding-bottom: S.s6;
            alignment: start;

            // Name, the account in use, then new chat and you.
            HorizontalLayout {
                padding-left: S.gutter;
                padding-right: S.s4;
                spacing: S.s2;
                height: 72px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: "Sanctm";
                        color: S.text;
                        font-family: S.sans;
                        font-size: 26px;
                        font-weight: 700;
                    }
                    Text {
                        text: App.accounts.length > 1 ? App.my-name + " · " + App.my-npub-short : App.my-npub-short;
                        color: S.muted;
                        font-family: App.accounts.length > 1 ? S.sans : S.mono;
                        font-size: S.t-meta;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconBtn {
                        size: 48px;
                        icon-size: 24px;
                        icon: S.dark ? Images.image("compose-d") : Images.image("compose-l");
                        clicked => {
                            Actions.new-chat();
                        }
                    }
                }
                // You: your avatar (or a person icon), opens Me.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: S.r-lg;
                        background: me-ta.pressed ? S.panel : transparent;
                        if !App.my-has-avatar: UserIcon {
                            width: 24px;
                            height: 24px;
                        }
                        if App.my-has-avatar: Avatar {
                            size: 36px;
                            picture: App.my-avatar;
                            has-picture: true;
                        }
                        me-ta := TouchArea {
                            clicked => {
                                Actions.show-me();
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: S.line;
            }

            LinkLine { }

            if App.toast != "" || App.storage-note != "": VerticalLayout {
                padding-left: S.gutter;
                padding-right: S.gutter;
                padding-top: S.s3;
                spacing: S.s3;
                if App.toast != "": Panel {
                    inner-padding: S.s3;
                    Body {
                        text: App.toast;
                        font-size: S.t-small;
                        font-weight: 600;
                    }
                }
                if App.storage-note != "": Panel {
                    accent: S.bad;
                    Body {
                        text: App.storage-note;
                        color: S.bad;
                        font-size: S.t-small;
                    }
                }
            }

            if root.empty: VerticalLayout {
                padding-left: S.gutter;
                padding-right: S.gutter;
                padding-top: 96px;
                EmptyState {
                    title: "No chats yet";
                    body: "Show your npub so a friend can scan it, or write to someone with their npub or name@domain.";
                }
            }

            for c[i] in App.chats: ChatItem {
                chat: c;
                last: i == App.chats.length - 1;
                open => {
                    Actions.open-chat(c.peer);
                }
            }
        }
    }

    // Empty: the two ways a first conversation starts, as the page's bottom buttons. Someone
    // new to Nostr usually has nobody to write to yet: showing the npub comes first.
    if root.empty: VerticalLayout {
        y: parent.height - root.empty-actions;
        height: root.empty-actions;
        padding-left: S.gutter;
        padding-right: S.gutter;
        padding-top: S.s3;
        padding-bottom: 28px;
        spacing: S.s3;
        Btn {
            text: "Show my npub";
            clicked => {
                Actions.show-me();
            }
        }
        Btn {
            text: "Write to someone";
            kind: 1;
            clicked => {
                Actions.new-chat();
            }
        }
    }
}
